---
// Builder face — hero, the arc, the machine pipeline, say-hello.
// CSS kept verbatim under `.bface` and emitted global (it references body.ready / body.is-flipping).
---

<div class="face face--builder is-active" data-face="builder">
  <div class="bface">
    <main>
      <section class="hero">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <h1 class="anim-in">AI architect.<span class="q"> The whole machine — from the browser to the model.</span></h1>
            <p class="lede anim-in"><b>Alexey Chudinov</b>, based in Prague. Years leading front-end and growing into architecture; now I build with AI at the center — agents, retrieval and pipelines, and the guardrails that keep them honest. I care about the whole system, not one layer.</p>
            <div class="cta-row anim-in">
              <a class="btn btn--primary" href="#contact">Say hello</a>
              <a class="btn btn--ghost" href="https://www.linkedin.com/in/alexeychudinov/" target="_blank" rel="noopener">LinkedIn</a>
            </div>
          </div>
          <div class="term anim-in" role="img" aria-label="Terminal: whoami prints 'alexey chudinov — ai architect'; the stack reads front-end to node.js to ai systems, with agents, retrieval, guardrails and evals; then a command ships the whole machine to production.">
            <div class="term-bar">
              <span class="tdot"></span><span class="tdot"></span><span class="tdot"></span>
              <span class="term-title">alexey@chudinov — zsh</span>
            </div>
            <div class="term-body">
              <div class="tln"><span class="pr">$</span> whoami</div>
              <div class="tln out">alexey chudinov — ai architect</div>
              <div class="tln sp"><span class="pr">$</span> cat stack.txt</div>
              <div class="tln out">front-end → node.js → ai systems</div>
              <div class="tln out">agents · retrieval · guardrails · evals</div>
              <div class="tln sp"><span class="pr">$</span> ./ship --target prod<span class="caret"></span></div>
            </div>
          </div>
        </div>
      </section>

      <section id="arc" aria-labelledby="arc-h">
        <div class="wrap reveal">
          <p class="sec-label">The arc</p>
          <h2 id="arc-h">One career, built downward through the stack.</h2>
          <p class="sec-lede">Each layer taught the next. I didn't jump into AI from the outside — I grew into it from the interface down.</p>
          <div class="gitlog">
            <p class="gl-cmd"><span class="pr">$</span> git log --oneline --graph career/</p>
            <ol class="gl-list">
              <li class="gl-commit">
                <span class="gl-graph" aria-hidden="true">*</span>
                <div class="gl-main">
                  <p class="gl-head"><span class="gl-hash">7c3e1a2</span> <span class="gl-ref">(front-end)</span> <span class="gl-msg">the interface</span></p>
                  <p class="gl-body">Years shipping accessible, fast product UI — systems get judged at the edge a person actually touches.</p>
                </div>
              </li>
              <li class="gl-commit">
                <span class="gl-graph" aria-hidden="true">*</span>
                <div class="gl-main">
                  <p class="gl-head"><span class="gl-hash">b4d9f08</span> <span class="gl-ref">(node.js)</span> <span class="gl-msg">the backend</span></p>
                  <p class="gl-body">Grew into Node and services — APIs, queues, data flow. Learned how state, latency and failure really behave under load.</p>
                </div>
              </li>
              <li class="gl-commit">
                <span class="gl-graph" aria-hidden="true">*</span>
                <div class="gl-main">
                  <p class="gl-head"><span class="gl-hash">e2a0c5d</span> <span class="gl-ref gl-ref-head">(HEAD → main, ai-architecture)</span> <span class="gl-msg">the whole machine</span></p>
                  <p class="gl-body">Now I design AI systems end to end — agents, retrieval, pipelines and evals, with guardrails wired in, not bolted on.</p>
                </div>
              </li>
            </ol>
          </div>
        </div>
      </section>

      <section id="machine" class="machine" aria-labelledby="machine-h">
        <div class="wrap reveal">
          <p class="sec-label">The machine</p>
          <h2 id="machine-h">A request has to survive the whole path.</h2>
          <p class="sec-lede">A production AI system is a pipeline, not a prompt. I design every stage of it — and the guardrails between them.</p>
          <div class="editor">
            <div class="ed-bar">
              <span class="tdot"></span><span class="tdot"></span><span class="tdot"></span>
              <span class="ed-file">pipeline.ts</span>
            </div>
            <ol class="ed-code" aria-label="A typed AI request pipeline: take a request, then retrieve grounding data, reason with tools, guard with validation and evals, and respond — grounded, traceable and in budget. A comment notes: I design the whole machine, not one layer; where it breaks is usually between the stages.">
              <li><span class="kw">export const</span> <span class="fn">answer</span> <span class="op">=</span> <span class="fn">pipeline</span><span class="op">(</span><span class="vr">request</span><span class="op">)</span></li>
              <li><span class="ind">&nbsp;&nbsp;</span><span class="op">.</span><span class="fn">retrieve</span><span class="op">()</span>  <span class="cm">// grounding data, ranked &amp; scoped</span></li>
              <li><span class="ind">&nbsp;&nbsp;</span><span class="op">.</span><span class="fn">reason</span><span class="op">()</span>  <span class="cm">// tools, planning, orchestration</span></li>
              <li><span class="ind">&nbsp;&nbsp;</span><span class="op">.</span><span class="fn">guard</span><span class="op">()</span>  <span class="cm">// validation, evals, safe fallbacks</span></li>
              <li><span class="ind">&nbsp;&nbsp;</span><span class="op">.</span><span class="fn">respond</span><span class="op">()</span>  <span class="cm">// grounded, traceable, in budget</span></li>
              <li>&nbsp;</li>
              <li><span class="cm">// I design the whole machine, not one layer —</span></li>
              <li><span class="cm">// where it breaks is usually between the stages.</span></li>
            </ol>
          </div>
        </div>
      </section>

      <section id="contact" class="contact" aria-labelledby="contact-h">
        <div class="wrap reveal">
          <p class="sec-label">Say hello</p>
          <h2 id="contact-h">Always glad to talk systems, AI — or banjo.</h2>
          <p class="sec-lede">This is my corner of the web, not a sales pitch. If something here resonates, drop a line — or turn the card over.</p>
          <p class="cform-head"><span class="pr">$</span> compose message <span class="cm">// all three fields, please</span></p>
          <form id="contact-form" class="cform" novalidate>
            <div class="field">
              <label for="cf-name"><span class="k">const</span> name <span class="eq">=</span></label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="cf-email"><span class="k">const</span> email <span class="eq">=</span></label>
              <input id="cf-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="cf-message"><span class="k">const</span> message <span class="eq">=</span></label>
              <textarea id="cf-message" name="message" rows="4" required></textarea>
            </div>
            <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="cform-actions">
              <button class="btn btn--primary" type="submit">Send message</button>
              <p class="form-status" role="status" aria-live="polite"></p>
            </div>
          </form>
        </div>
      </section>

      <footer>
        <div class="wrap">
          <span>chudinov.info</span>
          <span>soul.01 — IT</span>
        </div>
      </footer>
    </main>
  </div>
</div>

<style is:global>
  /* ========================================================= BUILDER FACE */
  .bface{
    --bg:#eef0f3;          /* cool neutral — deliberately NOT cream */
    --panel:#f8f9fb;
    --ink:#15171c;
    --soft:#565d6b;
    --faint:#5e6472;
    --line:rgba(21,23,28,.12);
    --line-soft:rgba(21,23,28,.07);
    --accent:#2743d6;      /* blueprint blue, used sparingly */
    --accent-soft:#e7eafc;
    --mono:ui-monospace,'SFMono-Regular',Menlo,Consolas,monospace;
    background:transparent;color:var(--ink);min-height:calc(100dvh - var(--topbar-h));
    font-weight:450;line-height:1.55;
  }
  .bface :focus-visible{outline:2.5px solid var(--accent);outline-offset:3px;border-radius:2px}
  .bface .wrap{max-width:1080px;margin-inline:auto;padding-inline:clamp(1.25rem,5vw,3.5rem);width:100%}

  /* header / switch bar */
  .bface .bhead{
    position:sticky;top:0;z-index:20;
    background:color-mix(in srgb,var(--bg) 86%,transparent);
    backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line-soft);
  }
  .bface .bhead .wrap{display:flex;align-items:center;justify-content:space-between;gap:1rem;
    padding-top:.85rem;padding-bottom:.85rem}
  .bface .brand{font-family:var(--mono);font-size:.78rem;letter-spacing:.04em;color:var(--soft)}
  .bface .brand b{color:var(--ink);font-weight:600}

  /* hero */
  .bface .hero{padding-top:clamp(3.5rem,11vw,8rem);padding-bottom:clamp(3rem,8vw,6rem)}
  .bface .hero-grid{display:grid;gap:clamp(2.2rem,5vw,3.5rem);align-items:center}
  @media (min-width:880px){ .bface .hero-grid{grid-template-columns:1.05fr .95fr} }

  /* hero terminal — a dark, geeky window on the light IT world */
  .bface .term{background:#0e1014;border:1px solid #23272f;border-radius:11px;overflow:hidden;
    box-shadow:0 34px 64px -40px rgba(14,16,20,.75);font-family:var(--mono);align-self:start;max-width:100%}
  .bface .term-bar{display:flex;align-items:center;gap:.5rem;padding:.6rem .85rem;background:#15181d;border-bottom:1px solid #23272f}
  .bface .term-bar .tdot{width:11px;height:11px;border-radius:50%;background:#3a3f49}
  .bface .term-bar .tdot:nth-child(1){background:#ff5f56}
  .bface .term-bar .tdot:nth-child(2){background:#ffbd2e}
  .bface .term-bar .tdot:nth-child(3){background:#27c93f}
  .bface .term-title{margin-left:.5rem;font-size:.72rem;color:#8b93a3;letter-spacing:.02em}
  .bface .term-body{padding:1.1rem 1.15rem;font-size:.84rem;line-height:1.75;color:#c9ced8;overflow-x:auto}
  .bface .term-body .tln{white-space:pre}
  .bface .term-body .tln.sp{margin-top:.75rem}
  .bface .term-body .pr{color:#57d08a;font-weight:600;margin-right:.1ch}
  .bface .term-body .out{color:#8b93a3}
  .bface .term-body .caret{display:inline-block;width:.55ch;height:1.05em;background:#57d08a;
    margin-left:.25ch;vertical-align:-2px;animation:tcaret 1.05s steps(1) infinite}
  @keyframes tcaret{50%{opacity:0}}
  @media (prefers-reduced-motion:reduce){ .bface .term-body .caret{animation:none} }
  .bface .eyebrow{font-family:var(--mono);font-size:.76rem;letter-spacing:.14em;text-transform:uppercase;
    color:var(--accent);margin:0 0 1.4rem}
  .bface h1{
    font-size:clamp(2.2rem,6vw,4.25rem);line-height:1.02;letter-spacing:-.03em;font-weight:600;
    margin:0;max-width:17ch;
  }
  .bface h1 .q{color:var(--soft);font-weight:450}
  .bface .lede{margin:1.8rem 0 0;max-width:54ch;font-size:clamp(1.05rem,1.6vw,1.28rem);color:var(--soft);line-height:1.6}
  .bface .cta-row{display:flex;flex-wrap:wrap;gap:.9rem;margin-top:clamp(2rem,4vw,2.8rem)}
  .bface .btn{
    display:inline-flex;align-items:center;gap:.6rem;font-family:var(--mono);font-size:.82rem;letter-spacing:.02em;
    text-decoration:none;padding:.9rem 1.3rem;border-radius:4px;border:1.5px solid var(--ink);
    color:var(--ink);background:transparent;transition:transform .3s cubic-bezier(.16,1,.3,1),background .3s ease,color .3s ease,border-color .3s ease;
  }
  .bface .btn--primary{background:var(--ink);color:var(--bg);border-color:var(--ink)}
  .bface .btn:hover{transform:translateY(-2px)}
  .bface .btn--primary:hover{background:var(--accent);border-color:var(--accent)}
  .bface .btn--ghost:hover{background:var(--ink);color:var(--bg)}
  @media (prefers-reduced-motion:reduce){.bface .btn{transition:background .2s ease,color .2s ease}.bface .btn:hover{transform:none}}

  /* generic section */
  .bface section{padding-block:clamp(3rem,7vw,5.5rem);border-top:1px solid var(--line-soft)}
  .bface .sec-label{font-family:var(--mono);font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;
    color:var(--faint);margin:0 0 1.6rem;display:flex;align-items:center;gap:.8rem}
  .bface .sec-label::before{content:"";width:1.6rem;height:1px;background:var(--line)}
  .bface h2{font-size:clamp(1.5rem,3vw,2.1rem);line-height:1.1;letter-spacing:-.02em;font-weight:600;margin:0 0 1rem;max-width:22ch}
  .bface .sec-lede{color:var(--soft);max-width:56ch;font-size:1.05rem;margin:0}

  /* the arc */
  .bface .arc{display:grid;gap:1px;background:var(--line-soft);border:1px solid var(--line-soft);border-radius:8px;overflow:hidden;margin-top:clamp(1.8rem,4vw,2.6rem)}
  .bface .arc-step{background:var(--panel);padding:clamp(1.4rem,3vw,2rem);display:grid;gap:.5rem;align-content:start}
  .bface .arc-step .n{font-family:var(--mono);font-size:.78rem;color:var(--accent);letter-spacing:.04em}
  .bface .arc-step h3{font-size:1.18rem;font-weight:600;letter-spacing:-.01em;margin:.1rem 0 .15rem}
  .bface .arc-step p{margin:0;color:var(--soft);font-size:.97rem;line-height:1.55}
  @media (min-width:760px){.bface .arc{grid-template-columns:repeat(3,1fr)}}

  /* the machine / pipeline diagram */
  .bface .machine .diagram{
    margin-top:clamp(1.8rem,4vw,2.6rem);padding:clamp(1.4rem,3.5vw,2.4rem);
    background:var(--panel);border:1px solid var(--line-soft);border-radius:10px;
  }
  .bface .pipeline{display:grid;gap:0;align-items:stretch}
  .bface .node{
    background:var(--bg);border:1.5px solid var(--line);border-radius:7px;
    padding:1rem 1.1rem;display:grid;gap:.25rem;position:relative;
  }
  .bface .node .tag{font-family:var(--mono);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}
  .bface .node .name{font-weight:600;font-size:1rem;letter-spacing:-.01em}
  .bface .node .desc{font-size:.82rem;color:var(--soft);line-height:1.45}
  .bface .pipe{position:relative;flex:none}
  .bface .pipe::before{
    content:"";position:absolute;background-image:linear-gradient(90deg,var(--accent) 0 45%,transparent 45% 100%);
    background-size:12px 2px;background-repeat:repeat-x;opacity:.75;
  }
  /* mobile: vertical stack */
  .bface .pipeline{grid-auto-flow:row;grid-template-columns:1fr}
  .bface .pipe{height:30px}
  .bface .pipe::before{left:50%;top:0;width:2px;height:100%;transform:translateX(-50%);
    background-image:linear-gradient(180deg,var(--accent) 0 45%,transparent 45% 100%);background-size:2px 12px;background-repeat:repeat-y;
    animation:flowY 1.1s linear infinite}
  @keyframes flowY{to{background-position:0 12px}}
  @media (min-width:860px){
    .bface .pipeline{grid-auto-flow:column;grid-template-columns:none;grid-auto-columns:1fr auto 1fr auto 1fr auto 1fr auto 1fr;align-items:center}
    .bface .pipe{height:2px;align-self:center}
    .bface .pipe::before{left:0;top:50%;width:100%;height:2px;transform:translateY(-50%);
      background-image:linear-gradient(90deg,var(--accent) 0 45%,transparent 45% 100%);background-size:12px 2px;background-repeat:repeat-x;
      animation:flowX 1.1s linear infinite}
  }
  @keyframes flowX{to{background-position:12px 0}}
  @media (prefers-reduced-motion:reduce){.bface .pipe::before{animation:none}}
  .bface .machine .note{margin:1.4rem 0 0;font-family:var(--mono);font-size:.82rem;color:var(--soft)}
  .bface .machine .note b{color:var(--ink);font-weight:600}

  /* work */
  .bface .work-list{margin-top:clamp(1.6rem,3.5vw,2.4rem);border-top:1px solid var(--line-soft)}
  .bface .work-item{display:grid;gap:.3rem;padding:1.3rem 0;border-bottom:1px solid var(--line-soft)}
  .bface .work-item .top{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap}
  .bface .work-item h3{font-size:1.15rem;font-weight:600;letter-spacing:-.01em;margin:0}
  .bface .work-item .kind{font-family:var(--mono);font-size:.74rem;color:var(--faint);letter-spacing:.04em;white-space:nowrap}
  .bface .work-item p{margin:.2rem 0 0;color:var(--soft);font-size:.96rem;max-width:62ch}
  .bface .work-item .stack{font-family:var(--mono);font-size:.74rem;color:var(--accent);margin-top:.4rem;letter-spacing:.02em}

  /* contact */
  .bface .contact .mail{display:inline-block;margin-top:.4rem;font-size:clamp(1.3rem,3.2vw,2rem);font-weight:600;letter-spacing:-.02em;
    color:var(--ink);text-decoration:none;border-bottom:2px solid var(--accent);padding-bottom:.1rem}
  .bface .contact .mail:hover{color:var(--accent)}
  .bface .flip-prompt{margin-top:clamp(2rem,5vw,3rem);padding-top:clamp(1.6rem,4vw,2.2rem);border-top:1px solid var(--line-soft);
    display:flex;align-items:center;gap:1.1rem;flex-wrap:wrap}
  .bface .flip-prompt span{color:var(--soft);font-size:.95rem}

  .bface footer{padding-block:clamp(2rem,4vw,3rem);border-top:1px solid var(--line-soft)}
  .bface footer .wrap{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;
    font-family:var(--mono);font-size:.76rem;color:var(--faint);letter-spacing:.03em}

  /* hero entrance (one-time, settles < 600ms) */
  .bface .anim-in{opacity:0;transform:translateY(14px)}
  body.ready .bface .anim-in{opacity:1;transform:none;transition:opacity .55s ease,transform .55s cubic-bezier(.16,1,.3,1)}
  body.ready .bface .anim-in:nth-child(2){transition-delay:.06s}
  body.ready .bface .anim-in:nth-child(3){transition-delay:.12s}
  body.ready .bface .anim-in:nth-child(4){transition-delay:.18s}
  @media (prefers-reduced-motion:reduce){.bface .anim-in{opacity:1!important;transform:none!important;transition:none!important}}

  /* reveal on scroll — restrained, once per block; JS adds .in when it enters view */
  .bface .reveal{opacity:0;transform:translateY(20px);
    transition:opacity .6s ease,transform .7s cubic-bezier(.16,1,.3,1)}
  .bface .reveal.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){.bface .reveal{opacity:1!important;transform:none!important;transition:none!important}}

  /* contact form */
  .bface .cform{margin-top:.7rem;max-width:40rem;display:grid;gap:1.1rem}
  .bface .field{display:grid;gap:.4rem}
  .bface .field label{font-family:var(--mono);font-size:.8rem;letter-spacing:.02em;color:var(--soft)}
  .bface .field label .k{color:#2743d6}
  .bface .field label .eq{color:var(--faint)}
  .bface .cform-head{margin:clamp(1.4rem,3vw,2rem) 0 .2rem;font-family:var(--mono);font-size:.82rem;color:var(--soft)}
  .bface .cform-head .pr{color:#0b8457;font-weight:600;margin-right:.4ch}
  .bface .cform-head .cm{color:#6f9a6a}
  .bface .field input,.bface .field textarea{
    font:inherit;color:var(--ink);background:var(--panel);
    border:1.5px solid var(--line);border-radius:6px;padding:.75rem .9rem;width:100%;
    transition:border-color .2s ease,box-shadow .2s ease}
  .bface .field textarea{resize:vertical;min-height:7rem;line-height:1.5}
  .bface .field input:focus,.bface .field textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
  .bface .field input:user-invalid,.bface .field textarea:user-invalid{border-color:#b3341f}
  .bface .cform .hp{display:none}
  .bface .cform-actions{display:flex;align-items:center;gap:1.1rem;flex-wrap:wrap;margin-top:.2rem}
  .bface .cform button[disabled]{opacity:.6;cursor:default}
  .bface .cform-actions .btn{cursor:pointer}
  .bface .form-status{margin:0;font-size:.9rem;color:var(--soft)}
  .bface .form-status[data-state="error"]{color:#b3341f}

  /* THE ARC → git log */
  .bface .gitlog{margin-top:clamp(1.8rem,4vw,2.6rem);font-family:var(--mono);font-size:.86rem;line-height:1.6;
    background:var(--panel);border:1px solid var(--line-soft);border-radius:10px;padding:clamp(1.3rem,3vw,1.9rem)}
  .bface .gl-cmd{margin:0 0 1.3rem;color:var(--soft)}
  .bface .gl-cmd .pr{color:#0b8457;font-weight:600;margin-right:.4ch}
  .bface .gl-list{list-style:none;margin:0;padding:0;display:grid;gap:1.2rem}
  .bface .gl-commit{position:relative;padding-left:1.7rem}
  .bface .gl-graph{position:absolute;left:.1rem;top:0;color:var(--accent);font-weight:700}
  .bface .gl-commit:not(:last-child)::before{content:"";position:absolute;left:.42rem;top:1.25rem;bottom:-1.2rem;width:1.5px;background:var(--line)}
  .bface .gl-head{margin:0}
  .bface .gl-hash{color:var(--faint)}
  .bface .gl-ref{color:var(--accent)}
  .bface .gl-ref-head{color:#0b8457}
  .bface .gl-msg{color:var(--ink);font-weight:600}
  .bface .gl-body{margin:.4rem 0 0;color:var(--soft);line-height:1.6;max-width:62ch}

  /* THE MACHINE → code editor */
  .bface .editor{margin-top:clamp(1.8rem,4vw,2.6rem);font-family:var(--mono);overflow:hidden;
    background:#fbfcfe;border:1px solid var(--line);border-radius:10px;box-shadow:0 24px 46px -34px rgba(21,23,28,.35)}
  .bface .ed-bar{display:flex;align-items:center;gap:.5rem;padding:.6rem .85rem;background:#eef1f6;border-bottom:1px solid var(--line-soft)}
  .bface .ed-bar .tdot{width:11px;height:11px;border-radius:50%;background:#cfd4dc}
  .bface .ed-bar .tdot:nth-child(1){background:#ff5f56}
  .bface .ed-bar .tdot:nth-child(2){background:#ffbd2e}
