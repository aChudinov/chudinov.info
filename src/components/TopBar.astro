---
// Persistent header — stays put; only the content below slides.
// Theming + knob state are driven by the flip controller via [data-side].
---

<header class="topbar" id="topbar" data-side="builder">
  <div class="wrap">
    <div class="brand">Alexey <b>Chudinov</b> <span class="soul" aria-hidden="true">/ soul.01</span></div>
    <button class="flip" type="button" data-side="builder" aria-pressed="false" aria-label="Flip to the music side">
      <span class="flip__end flip__end--l">IT</span>
      <span class="flip__track" aria-hidden="true"><span class="flip__knob"></span></span>
      <span class="flip__end flip__end--r">Music</span>
    </button>
  </div>
</header>
