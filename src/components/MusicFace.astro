                <text class="mf-sname" x="40" y="34" text-anchor="end">D</text>
                <text class="mf-sname" x="40" y="62" text-anchor="end">B</text>
                <text class="mf-sname" x="40" y="90" text-anchor="end">G</text>
                <text class="mf-sname" x="40" y="118" text-anchor="end">D</text>
                <text class="mf-sname" x="40" y="146" text-anchor="end">g</text>
                <line class="mf-barline" x1="56" y1="30" x2="56" y2="142"/>
                <line class="mf-barline" x1="360" y1="30" x2="360" y2="142"/>
                <line class="mf-barline" x1="662" y1="30" x2="662" y2="142"/>
                <line class="mf-barline" x1="657" y1="30" x2="657" y2="142"/>
                <rect class="mf-slab" x="83" y="78" width="14" height="16"/><text class="mf-num" x="90" y="91" text-anchor="middle">0</text>
                <rect class="mf-slab" x="119" y="50" width="14" height="16"/><text class="mf-num" x="126" y="63" text-anchor="middle">0</text>
                <rect class="mf-slab" x="155" y="22" width="14" height="16"/><text class="mf-num" x="162" y="35" text-anchor="middle">0</text>
                <rect class="mf-slab" x="191" y="134" width="14" height="16"/><text class="mf-num" x="198" y="147" text-anchor="middle">0</text>
                <rect class="mf-slab" x="227" y="78" width="14" height="16"/><text class="mf-num" x="234" y="91" text-anchor="middle">0</text>
                <rect class="mf-slab" x="263" y="50" width="14" height="16"/><text class="mf-num" x="270" y="63" text-anchor="middle">0</text>
                <rect class="mf-slab" x="299" y="22" width="14" height="16"/><text class="mf-num" x="306" y="35" text-anchor="middle">0</text>
                <rect class="mf-slab" x="335" y="134" width="14" height="16"/><text class="mf-num" x="342" y="147" text-anchor="middle">0</text>
                <rect class="mf-slab" x="367" y="78" width="30" height="16"/><text class="mf-num" x="382" y="91" text-anchor="middle">0h2</text>
                <rect class="mf-slab" x="407" y="50" width="14" height="16"/><text class="mf-num" x="414" y="63" text-anchor="middle">0</text>
                <rect class="mf-slab" x="443" y="22" width="14" height="16"/><text class="mf-num" x="450" y="35" text-anchor="middle">0</text>
                <rect class="mf-slab" x="479" y="134" width="14" height="16"/><text class="mf-num" x="486" y="147" text-anchor="middle">0</text>
                <rect class="mf-slab" x="515" y="106" width="14" height="16"/><text class="mf-num" x="522" y="119" text-anchor="middle">2</text>
                <rect class="mf-slab" x="551" y="50" width="14" height="16"/><text class="mf-num" x="558" y="63" text-anchor="middle">0</text>
                <rect class="mf-slab" x="587" y="22" width="14" height="16"/><text class="mf-num" x="594" y="35" text-anchor="middle">0</text>
                <rect class="mf-slab" x="623" y="134" width="14" height="16"/><text class="mf-num" x="630" y="147" text-anchor="middle">0</text>
                <text class="mf-sname" x="90"  y="172" text-anchor="middle">T</text>
                <text class="mf-sname" x="126" y="172" text-anchor="middle">I</text>
                <text class="mf-sname" x="162" y="172" text-anchor="middle">M</text>
                <text class="mf-sname" x="198" y="172" text-anchor="middle">T</text>
                <text class="mf-sname" x="234" y="172" text-anchor="middle">T</text>
                <text class="mf-sname" x="270" y="172" text-anchor="middle">I</text>
                <text class="mf-sname" x="306" y="172" text-anchor="middle">M</text>
                <text class="mf-sname" x="342" y="172" text-anchor="middle">T</text>
              </g>
            </svg>
          </div>

          <div class="mf-panel">
            <div class="mf-fbhead">
              <span class="mf-bar" style="margin:0"><span class="mf-pl">fretboard</span></span>
              <div class="mf-seg" role="group" aria-label="Playing hand">
                <button type="button" class="mf-hand-right" aria-pressed="false">Right</button>
                <button type="button" class="mf-hand-left" aria-pressed="true">Left</button>
              </div>
            </div>
            <svg class="mf-fret mf-left mf-fretboard" viewBox="0 0 680 230" role="img"
              aria-label="A five-string banjo neck diagram. Four long strings run the length of the neck; the short fifth string begins at the fifth fret. One finger is at the second fret of the G string; the other strings ring open. The diagram mirrors between right- and left-handed.">
              <g class="mf-neckgroup">
                <rect class="mf-neck" x="80" y="40" width="552" height="150" rx="4"/>
                <rect class="mf-nut" x="76" y="38" width="8" height="154" rx="2"/>
