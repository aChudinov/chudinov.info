---
// Music face: the mface fragment, verbatim-scoped under .mface (inline CSS/JS so
// Astro leaves it untouched). The 5 strings are the page MENU; each plucks to a
// fact. A generic intro shows by default. The fretboard+tab is one fact ("the
// neck"); other facts use distinct non-musical presentations (placeholders for now).
import { useTranslations, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// strings the inline IIFE needs (is:inline can't read `t()`, so pass via define:vars)
const mf = {
  factTitles: [t('music.fact0.h'), t('music.fact1.h'), t('music.fact2.h'), t('music.fact3.h'), t('music.fact4.h')],
  pluckAria: t('music.string.aria'),
  captionLeft: t('music.fact2.caption.left'),
  captionRight: t('music.fact2.caption.right'),
};
---

<div class="face face--music is-hidden" data-face="music" inert>
<!-- MUSIC FACE — self-scoped CSS/JS under .mface. Strings = menu. Fretboard defaults to LEFT. -->
<section class="mface" aria-label="Alexey Chudinov — musician">
  <style is:inline>
  .mface{
    --mf-ink:#141210;
    --mf-paper:#efe7d6;
    --mf-paper-2:#e7dcc4;
    --mf-paper-line:#d8cbac;
    --mf-accent:#d98a1f;
    --mf-accent-ink:#8a5a10;
    --mf-accent-deep:#704a08;
    --mf-on-paper:#141210;
    --mf-on-paper-soft:#5c5343;
    --mf-on-ink:#f2ead9;
    --mf-mono:ui-monospace,'SFMono-Regular',Menlo,Consolas,monospace;
    --mf-sans:system-ui,-apple-system,'Segoe UI',sans-serif;
    --mf-ease:cubic-bezier(.16,1,.3,1);
    box-sizing:border-box;display:block;background:transparent;color:var(--mf-on-paper);
    font-family:var(--mf-sans);font-weight:500;line-height:1.5;padding:clamp(1.5rem,5vw,4rem);
  }
  .mface *,.mface *::before,.mface *::after{box-sizing:border-box}
  .mface :focus-visible{outline:2.5px solid var(--mf-accent-ink);outline-offset:3px;border-radius:2px}
  .mface .mf-wrap{max-width:1180px;margin-inline:auto;width:100%}

  .mface .mf-title{font-weight:900;letter-spacing:-.035em;line-height:.95;margin:0;font-size:clamp(2.2rem,6.5vw,4.6rem)}
  .mface .mf-title .mf-amp{color:var(--mf-accent-ink)}
  .mface .mf-lede{max-width:56ch;margin:1.4rem 0 0;font-size:clamp(1.05rem,1.5vw,1.28rem);line-height:1.62}
  .mface .mf-lede .mf-hl{color:var(--mf-accent-ink);font-weight:700}

  /* ---- the banjo instrument = the page menu ---- */
  /* desktop: instrument on the left, fact content on the right; mobile: instrument hero on top, content below */
  .mface .mf-body{display:grid;gap:clamp(2rem,5vw,3rem);margin-top:clamp(2.2rem,5vw,3.2rem)}
  @media(min-width:760px){
    .mface .mf-body{grid-template-columns:auto minmax(0,1fr);align-items:start;gap:clamp(2.5rem,5vw,4.5rem)}
    .mface .mf-stage{margin-top:0}
  }
  .mface .mf-menu-hint{font-family:var(--mf-mono);font-size:.78rem;color:var(--mf-on-paper-soft);margin:0 0 1.2rem}

  /* stage = the cream drum head the string assembly sits on */
  /* the instrument sits directly on the cream world — no panel */
  /* viewBox is cropped tight to the banjo (80 44 240 636), so sizing is height-driven
     and the instrument itself stays the same size — just without the empty margins */
  .mface .mf-instr{position:relative;margin-inline:auto;aspect-ratio:240/636;height:clamp(520px,68vh,760px);width:auto}
  .mface .mf-instr-svg{display:block;width:100%;height:100%}
  .mface .mf-istring{cursor:pointer}
  .mface .mf-istring .mf-iwire{transition:stroke .2s ease}
  .mface .mf-istring:hover .mf-iwire,.mface .mf-istring[aria-pressed="true"] .mf-iwire{stroke:var(--mf-accent)}
  .mface .mf-istring:focus-visible .mf-iwire{stroke:var(--mf-accent-ink)}
  /* no box outline on the string button — the wire colour is the focus/press cue */
  .mface .mf-istring:focus{outline:none}

  /* "da capo" — mobile-only return-to-top; desktop hides it (no scroll there) */
  .mface .mf-dacapo{display:none}

  /* mobile: the banjo becomes a near-full-screen vertical hero at the top */
  @media(max-width:759px){
    .mface .mf-instr{height:min(82vh,640px);width:auto;max-width:94vw}
    .mface .mf-menu-hint{text-align:center}
    .mface .mf-dacapo{
      display:flex;align-items:center;justify-content:center;gap:.7rem;
      width:100%;margin:2.6rem 0 0;padding:1.5rem 1rem 0.4rem;
      appearance:none;background:transparent;border:0;border-top:1px solid var(--mf-paper-line);
      color:var(--mf-accent-ink);cursor:pointer;transition:opacity .2s ease,transform .2s var(--mf-ease);
    }
    .mface .mf-dacapo .mf-dc-sign{width:1.5rem;height:1.5rem;flex:none}
    .mface .mf-dacapo .mf-dc-text{display:flex;flex-direction:column;align-items:flex-start;line-height:1.2}
    .mface .mf-dacapo .mf-dc-main{font-family:var(--mf-mono);font-weight:700;font-size:.98rem;letter-spacing:.04em}
    .mface .mf-dacapo .mf-dc-sub{font-family:var(--mf-mono);font-size:.72rem;letter-spacing:.06em;color:var(--mf-on-paper-soft)}
    .mface .mf-dacapo:active{opacity:.6;transform:translateY(-1px)}
  }
  @media(max-width:759px) and (prefers-reduced-motion:reduce){
    .mface .mf-dacapo{transition:none}
  }

  /* ---- fact stage ---- */
  .mface .mf-stage{margin-top:clamp(2.2rem,5vw,3.2rem);min-height:clamp(200px,30vh,300px)}
  .mface .mf-fp[hidden]{display:none}
  .mface .mf-fp{animation:mf-fade .4s ease}
  @keyframes mf-fade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  .mface .mf-fp-h{font-family:var(--mf-mono);font-size:.76rem;letter-spacing:.09em;text-transform:uppercase;color:var(--mf-accent-ink);margin:0 0 1.1rem}
  .mface .mf-hint{font-family:var(--mf-mono);font-size:.8rem;color:var(--mf-on-paper-soft);margin:1.4rem 0 0}

  /* fact: stat */
  .mface .mf-stat{display:flex;align-items:baseline;gap:.7rem;flex-wrap:wrap}
  .mface .mf-stat-num{font-weight:900;font-size:clamp(3rem,11vw,6rem);line-height:.85;letter-spacing:-.04em}
  .mface .mf-stat-unit{font-family:var(--mf-mono);font-size:1.05rem;color:var(--mf-accent-deep)}
  .mface .mf-stat-label{margin:1rem 0 0;font-size:clamp(1.05rem,1.6vw,1.25rem);color:var(--mf-on-paper-soft);max-width:40ch}

  /* intro: stage photo framed like a window (rhymes with the IT code windows, warmed) */
  .mface .mf-photo{margin:1.8rem 0 0;max-width:520px;border:1px solid var(--mf-paper-line);border-radius:11px;
    overflow:hidden;background:var(--mf-paper-2);box-shadow:0 28px 50px -34px rgba(20,18,16,.5)}
  .mface .mf-photo-bar{display:flex;align-items:center;gap:.5rem;padding:.55rem .8rem;background:var(--mf-paper);border-bottom:1px solid var(--mf-paper-line)}
  .mface .mf-photo-bar .mf-pd{width:10px;height:10px;border-radius:50%;background:var(--mf-paper-line)}
  .mface .mf-photo-bar .mf-pd:nth-child(1){background:#d98a1f}
  .mface .mf-photo-bar .mf-pd:nth-child(2){background:#caa24a}
  .mface .mf-photo-bar .mf-pd:nth-child(3){background:#9ab06a}
  .mface .mf-photo-name{margin-left:.4rem;font-family:var(--mf-mono);font-size:.72rem;color:var(--mf-on-paper-soft)}
  .mface .mf-photo-img{display:block;width:100%;height:auto}
  .mface .mf-photo-cap{margin:0;padding:.7rem .85rem;font-family:var(--mf-mono);font-size:.76rem;
    color:var(--mf-on-paper-soft);background:var(--mf-paper);border-top:1px solid var(--mf-paper-line)}
  .mface .mf-photo-cap::before{content:"\266A  ";color:var(--mf-accent-ink)}

  /* fact: history timeline — a banjo "string" rail with amber fret-marker nodes */
  .mface .mf-timeline{list-style:none;margin:0;padding:0}
  .mface .mf-tl{position:relative;display:grid;grid-template-columns:20px minmax(0,1fr);gap:.95rem;padding-bottom:1.5rem}
  .mface .mf-tl:last-child{padding-bottom:0}
  .mface .mf-tl::before{content:"";position:absolute;left:5px;top:0;bottom:0;width:2px;background:#5b5446;opacity:.4}
  .mface .mf-tl:first-child::before{top:9px}
  .mface .mf-tl:last-child::before{bottom:auto;height:9px}
  .mface .mf-tl-node{width:12px;height:12px;margin-top:3px;border-radius:50%;background:var(--mf-accent);
    border:2.5px solid var(--mf-paper);position:relative;z-index:1}
  .mface .mf-tl-when{display:inline-block;font-family:var(--mf-mono);font-size:.74rem;letter-spacing:.06em;
    text-transform:uppercase;color:var(--mf-accent-deep)}
  .mface .mf-tl-text{margin:.3rem 0 0;color:var(--mf-on-paper);line-height:1.55;max-width:46ch}
  .mface .mf-tl-hint{margin:.55rem 0 0;font-family:var(--mf-mono);font-size:.76rem;color:var(--mf-on-paper-soft)}

  /* generic body paragraph for the content facts */
  .mface .mf-ptext{margin:0;color:var(--mf-on-paper);line-height:1.6;max-width:52ch;font-size:clamp(1.02rem,1.4vw,1.18rem)}

  /* family: two video slots (framed like the photo window; posters until clips land) */
  .mface .mf-vids{display:grid;gap:1.1rem;margin:1.6rem 0 0}
  @media(min-width:620px){.mface .mf-vids{grid-template-columns:1fr 1fr}}
  .mface .mf-vid{border:1px solid var(--mf-paper-line);border-radius:11px;overflow:hidden;background:var(--mf-paper-2);box-shadow:0 20px 40px -32px rgba(20,18,16,.5)}
  .mface .mf-vid-stage{position:relative;aspect-ratio:16/10;background:linear-gradient(135deg,#2a2622,#1b1712);display:grid;place-items:center}
  .mface .mf-play{width:46px;height:46px;border-radius:50%;background:rgba(243,241,234,.92);display:grid;place-items:center}
  .mface .mf-play::before{content:"";border-style:solid;border-width:8px 0 8px 13px;border-color:transparent transparent transparent #1b1712;margin-left:3px}
  .mface .mf-vid-soon{position:absolute;top:.6rem;right:.6rem;font-family:var(--mf-mono);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mf-on-ink);background:rgba(20,18,16,.5);padding:.2rem .5rem;border-radius:999px}
  .mface .mf-vid-cap{margin:0;padding:.65rem .8rem;font-family:var(--mf-mono);font-size:.74rem;color:var(--mf-on-paper-soft);background:var(--mf-paper);border-top:1px solid var(--mf-paper-line)}
  /* YouTube facade: self-hosted poster + play; the iframe loads only on click */
  .mface .mf-yt{position:absolute;inset:0;width:100%;height:100%;padding:0;border:0;background:transparent;cursor:pointer;display:grid;place-items:center}
  .mface .mf-yt-poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .mface .mf-yt .mf-play{position:relative;z-index:1;transition:transform .2s var(--mf-ease),background .2s ease}
  .mface .mf-yt:hover .mf-play{transform:scale(1.08);background:#fff}
  .mface .mf-yt:focus-visible{outline:2.5px solid var(--mf-accent-ink);outline-offset:-3px}
  /* video modal/lightbox — mounted on document.body, so these rules are global */
  .mf-modal{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:clamp(1rem,4vw,3rem)}
  .mf-modal[hidden]{display:none}
  .mf-modal-backdrop{position:absolute;inset:0;background:rgba(18,16,14,.8);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
  .mf-modal-dialog{position:relative;width:min(960px,100%,calc((100dvh - 7rem) * 16 / 9));animation:mf-modal-in .3s cubic-bezier(.16,1,.3,1)}
  .mf-modal-frame{aspect-ratio:16/9;border-radius:11px;overflow:hidden;background:#000;box-shadow:0 44px 90px -28px rgba(0,0,0,.7)}
  .mf-modal-frame iframe{display:block;width:100%;height:100%;border:0}
  .mf-modal-close{position:absolute;top:.6rem;right:.6rem;z-index:2;display:grid;place-items:center;width:2.2rem;height:2.2rem;
    border:0;border-radius:50%;background:rgba(18,16,14,.6);color:#f3f1ea;cursor:pointer;transition:background .2s ease,transform .2s ease}
  .mf-modal-close:hover{background:rgba(18,16,14,.85);transform:scale(1.06)}
  .mf-modal-close:focus-visible{outline:2.5px solid #f3f1ea;outline-offset:2px}
  @keyframes mf-modal-in{from{opacity:0;transform:scale(.97)}to{opacity:1;transform:none}}
  @media (prefers-reduced-motion:reduce){.mf-modal-dialog{animation:none}}

  /* the scene: memory-box card grid */
  .mface .mf-mem{display:grid;gap:.9rem;margin:1.5rem 0 0}
  @media(min-width:560px){.mface .mf-mem{grid-template-columns:1fr 1fr}}
  .mface .mf-mem-card{padding:1.1rem 1.2rem;background:var(--mf-paper-2);border:1px solid var(--mf-paper-line);border-radius:10px;transition:border-color .2s ease,transform .2s var(--mf-ease)}
  .mface .mf-mem-card:hover{border-color:var(--mf-accent);transform:translateY(-2px)}
  .mface .mf-mem-tag{margin:0;font-family:var(--mf-mono);font-size:.72rem;letter-spacing:.09em;text-transform:uppercase;color:var(--mf-accent-ink)}
  .mface .mf-mem-txt{margin:.35rem 0 0;color:var(--mf-on-paper-soft);font-size:.95rem;line-height:1.5}
  .mface .mf-soon{margin:1.1rem 0 0;font-family:var(--mf-mono);font-size:.76rem;color:var(--mf-on-paper-soft)}

  /* dystonia link + left-handed intro */
  .mface .mf-dys-link{margin:1.2rem 0 0;font-family:var(--mf-mono);font-size:.82rem;color:var(--mf-accent-ink)}
  .mface .mf-lh-intro{margin:0 0 1.4rem;font-size:clamp(1.02rem,1.4vw,1.18rem);line-height:1.6;color:var(--mf-on-paper);max-width:54ch}

  /* fact: progress */
  .mface .mf-bar2{height:12px;background:var(--mf-paper-2);border:1px solid var(--mf-paper-line);border-radius:999px;overflow:hidden;max-width:440px}
  .mface .mf-bar2-fill{height:100%;background:var(--mf-accent);border-radius:999px}
  .mface .mf-fp-sub{margin:1rem 0 0;color:var(--mf-on-paper-soft);max-width:44ch}

  /* fact: terminal line (one dark moment in the warm world) */
  .mface .mf-term{font-family:var(--mf-mono);font-size:.88rem;background:var(--mf-ink);color:var(--mf-on-ink);
    border-radius:9px;padding:1.2rem 1.3rem;line-height:1.9;overflow-x:auto;box-shadow:0 24px 44px -32px rgba(20,18,16,.5)}
  .mface .mf-term .mf-pr{color:var(--mf-accent)}
  .mface .mf-term .mf-dim{color:#a99;opacity:.8}

  /* fact: tags */
  .mface .mf-tags{display:flex;flex-wrap:wrap;gap:.6rem}
  .mface .mf-chip{font-family:var(--mf-mono);font-size:.82rem;padding:.42rem .85rem;border:1.5px solid var(--mf-on-paper);
    border-radius:999px;color:var(--mf-on-paper);transition:background .2s ease,color .2s ease}
  .mface .mf-chip:hover{background:var(--mf-on-paper);color:var(--mf-paper)}

  /* fact: the neck (tablature + fretboard) */
  .mface .mf-score{display:grid;gap:clamp(1.4rem,3vw,2.2rem)}
  .mface .mf-panel{background:var(--mf-paper-2);border:1px solid var(--mf-paper-line);border-radius:9px;
    padding:clamp(1rem,2.2vw,1.6rem);box-shadow:0 24px 44px -32px rgba(20,18,16,.5)}
  .mface .mf-bar{display:flex;align-items:center;justify-content:space-between;gap:1rem;
    font-family:var(--mf-mono);font-size:.8rem;color:var(--mf-on-paper-soft);margin-bottom:.9rem}
  .mface .mf-bar .mf-pl{color:var(--mf-on-paper);font-weight:500}
  .mface .mf-bar .mf-pt{color:var(--mf-accent-deep)}
  .mface .mf-tab,.mface .mf-fret{display:block;width:100%;height:auto}
  .mface .mf-tab .mf-staff{stroke:var(--mf-on-paper-soft);stroke-width:1;opacity:.55}
  .mface .mf-tab .mf-barline{stroke:var(--mf-on-paper);stroke-width:1.4}
  .mface .mf-tab .mf-num{font-family:var(--mf-mono);font-size:15px;font-weight:500;fill:var(--mf-on-paper)}
  .mface .mf-tab .mf-slab{fill:var(--mf-paper-2)}
  .mface .mf-tab .mf-clef{font-family:var(--mf-mono);font-size:13px;font-weight:700;fill:var(--mf-accent-ink);letter-spacing:1px}
  .mface .mf-tab .mf-sname{font-family:var(--mf-mono);font-size:12px;fill:var(--mf-on-paper-soft)}
  .mface .mf-fbhead{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:1rem}
  .mface .mf-seg{display:inline-flex;border:1.5px solid var(--mf-on-paper);border-radius:4px;overflow:hidden;font-family:var(--mf-mono);font-size:.8rem}
  .mface .mf-seg button{appearance:none;border:0;background:transparent;color:var(--mf-on-paper);padding:.5rem .95rem;cursor:pointer;font:inherit;letter-spacing:.02em}
  .mface .mf-seg button[aria-pressed="true"]{background:var(--mf-ink);color:var(--mf-on-ink)}
  .mface .mf-seg button+button{border-left:1.5px solid var(--mf-on-paper)}
  .mface .mf-neck{stroke:none;fill:var(--mf-paper)}
  .mface .mf-fretline{stroke:var(--mf-on-paper-soft);stroke-width:1.4}
  .mface .mf-nut{fill:var(--mf-on-paper)}
  .mface .mf-string{stroke:var(--mf-on-paper);stroke-width:1.2}
  .mface .mf-string.mf-wound{stroke-width:2}
  .mface .mf-inlay{fill:var(--mf-on-paper-soft);opacity:.5}
  .mface .mf-open-mark{fill:none;stroke:var(--mf-on-paper);stroke-width:1.5}
  .mface .mf-string-nut{fill:var(--mf-on-paper)}
  .mface .mf-finger{fill:var(--mf-accent)}
  .mface .mf-fingnum{font-family:var(--mf-mono);font-size:13px;font-weight:700;fill:#fff;text-anchor:middle}
  /* keep finger numbers readable when the neck is mirrored for left-handed */
  .mface .mf-fret.mf-left .mf-fingnum{transform:scaleX(-1);transform-box:fill-box;transform-origin:center}
  .mface .mf-peg{fill:var(--mf-accent-ink)}
  .mface .mf-neckgroup{transform-box:view-box;transform-origin:center;transition:transform .6s var(--mf-ease)}
  .mface .mf-fret.mf-left .mf-neckgroup{transform:scaleX(-1)}
  .mface .mf-fbcaption{font-family:var(--mf-mono);font-size:.78rem;color:var(--mf-on-paper-soft);margin-top:.9rem}
  .mface .mf-fbcaption b{color:var(--mf-accent-deep);font-weight:500}
  .mface .mf-fname-side{font-family:var(--mf-mono);font-size:12px;fill:var(--mf-on-paper-soft)}

  @media(prefers-reduced-motion:reduce){
    .mface .mf-neckgroup{transition:none}
    .mface .mf-fp{animation:none}
  }
  </style>

  <div class="mf-wrap">
    <h2 class="mf-title">{t('music.title.main')}<span class="mf-amp">.</span></h2>

    <div class="mf-body">
    <!-- BANJO INSTRUMENT MENU (left on desktop, hero on mobile) -->
    <div class="mf-menu">
      <p class="mf-menu-hint">{t('music.menuHint')}</p>
      <div class="mf-instr">
        <svg class="mf-instr-svg" viewBox="80 44 240 636" role="group"
          aria-label={t('music.instr.aria')}>
          <g class="mf-assembly">
            <g class="mf-g-bridge"></g>
            <g class="mf-g-strings"></g>
            <g class="mf-g-tail"></g>
          </g>
        </svg>
      </div>
    </div>

    <!-- FACT STAGE -->
    <div class="mf-stage" aria-live="polite">
      <!-- default: generic intro + stage photo (framed like the IT code windows) -->
      <div class="mf-fp mf-fp-intro" data-k="default">
        <p class="mf-lede" set:html={t('music.intro')}></p>
        <figure class="mf-photo">
          <div class="mf-photo-bar" aria-hidden="true"><span class="mf-pd"></span><span class="mf-pd"></span><span class="mf-pd"></span><span class="mf-photo-name">live.jpg</span></div>
          <picture>
            <source srcset="/img/alexey-live.webp" type="image/webp" />
            <img class="mf-photo-img" src="/img/alexey-live.jpg" width="1500" height="1000" loading="lazy" decoding="async"
              alt="Alexey Chudinov playing the five-string banjo on stage under blue and red lights." />
          </picture>
          <figcaption class="mf-photo-cap">{t('music.intro.caption')}</figcaption>
        </figure>
        <p class="mf-hint">{t('music.intro.hint')}</p>
      </div>

      <!-- k=0 · history (timeline on a banjo "string" with fret-marker nodes) -->
      <div class="mf-fp" data-k="0" hidden>
        <p class="mf-fp-h">{t('music.fact0.h')}</p>
        <ol class="mf-timeline">
          <li class="mf-tl"><span class="mf-tl-node" aria-hidden="true"></span><div class="mf-tl-body"><span class="mf-tl-when">{t('music.hist.w1')}</span><p class="mf-tl-text">{t('music.hist.t1')}</p></div></li>
          <li class="mf-tl"><span class="mf-tl-node" aria-hidden="true"></span><div class="mf-tl-body"><span class="mf-tl-when">{t('music.hist.w2')}</span><p class="mf-tl-text">{t('music.hist.t2')}</p></div></li>
          <li class="mf-tl"><span class="mf-tl-node" aria-hidden="true"></span><div class="mf-tl-body"><span class="mf-tl-when">{t('music.hist.w3')}</span><p class="mf-tl-text">{t('music.hist.t3')}</p></div></li>
