---
// Music face: the mface fragment, verbatim. CSS and JS are self-scoped under
// the mface class and kept inline so Astro leaves them untouched, exactly like
// the original embedded fragment. Fretboard defaults to LEFT.
---

<div class="face face--music is-hidden" data-face="music" inert>
<!-- MUSIC FACE — embed this whole fragment inside a container. Self-scoped CSS/JS under .mface. Fretboard defaults to LEFT. -->
<section class="mface" aria-label="Alexey Chudinov — musician">
  <style is:inline>
  .mface{
    /* scoped palette — warm cream, from V4 */
    --mf-ink:#141210;
    --mf-paper:#efe7d6;
    --mf-paper-2:#e7dcc4;
    --mf-paper-line:#d8cbac;
    --mf-accent:#d98a1f;
    --mf-accent-ink:#8a5a10;
    --mf-accent-deep:#704a08;
    --mf-on-paper:#141210;
    --mf-on-paper-soft:#5c5343;
    --mf-on-ink:#f2ead9;
    --mf-rule-paper:rgba(20,18,16,.14);
    --mf-mono:ui-monospace,'SFMono-Regular',Menlo,Consolas,monospace;
    --mf-sans:system-ui,-apple-system,'Segoe UI',sans-serif;
    --mf-ease:cubic-bezier(.16,1,.3,1);

    box-sizing:border-box;
    display:block;
    background:var(--mf-paper);
    color:var(--mf-on-paper);
    font-family:var(--mf-sans);
    font-weight:500;
    line-height:1.5;
    padding:clamp(1.5rem,5vw,4rem);
  }
  .mface *,.mface *::before,.mface *::after{box-sizing:border-box}
  .mface :focus-visible{outline:2.5px solid var(--mf-accent-ink);outline-offset:3px;border-radius:2px}

  .mface .mf-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(2rem,4vw,3.2rem);max-width:1180px;margin-inline:auto;width:100%}

  .mface .mf-title{font-weight:900;letter-spacing:-.035em;line-height:.95;margin:0;font-size:clamp(2.2rem,6.5vw,4.6rem)}
  .mface .mf-title .mf-amp{color:var(--mf-accent-ink)}
  .mface .mf-lede{max-width:56ch;margin:1.4rem 0 0;font-size:clamp(1.05rem,1.5vw,1.28rem);line-height:1.62}
  .mface .mf-lede .mf-hl{color:var(--mf-accent-ink);font-weight:700}

  /* panels: tablature + fretboard */
  .mface .mf-score{margin-top:clamp(2rem,4vw,3rem);display:grid;gap:clamp(1.4rem,3vw,2.2rem)}
  .mface .mf-panel{background:var(--mf-paper-2);border:1px solid var(--mf-paper-line);border-radius:9px;
    padding:clamp(1rem,2.2vw,1.6rem);box-shadow:0 24px 44px -32px rgba(20,18,16,.5)}
  .mface .mf-bar{display:flex;align-items:center;justify-content:space-between;gap:1rem;
    font-family:var(--mf-mono);font-size:.8rem;color:var(--mf-on-paper-soft);margin-bottom:.9rem}
  .mface .mf-bar .mf-pl{color:var(--mf-on-paper);font-weight:500}
  .mface .mf-bar .mf-pt{color:var(--mf-accent-deep)}

  .mface .mf-tab,.mface .mf-fret{display:block;width:100%;height:auto}
  .mface .mf-tab .mf-staff{stroke:var(--mf-on-paper-soft);stroke-width:1;opacity:.55}
  .mface .mf-tab .mf-barline{stroke:var(--mf-on-paper);stroke-width:1.4}
  .mface .mf-tab .mf-num{font-family:var(--mf-mono);font-size:15px;font-weight:500;fill:var(--mf-on-paper)}
  .mface .mf-tab .mf-slab{fill:var(--mf-paper-2)}
  .mface .mf-tab .mf-clef{font-family:var(--mf-mono);font-size:13px;font-weight:700;fill:var(--mf-accent-ink);letter-spacing:1px}
  .mface .mf-tab .mf-sname{font-family:var(--mf-mono);font-size:12px;fill:var(--mf-on-paper-soft)}

  /* fretboard */
  .mface .mf-fbhead{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:1rem}
  .mface .mf-seg{display:inline-flex;border:1.5px solid var(--mf-on-paper);border-radius:4px;overflow:hidden;font-family:var(--mf-mono);font-size:.8rem}
  .mface .mf-seg button{appearance:none;border:0;background:transparent;color:var(--mf-on-paper);
    padding:.5rem .95rem;cursor:pointer;font:inherit;letter-spacing:.02em}
  .mface .mf-seg button[aria-pressed="true"]{background:var(--mf-ink);color:var(--mf-on-ink)}
  .mface .mf-seg button+button{border-left:1.5px solid var(--mf-on-paper)}
  .mface .mf-neck{stroke:none;fill:var(--mf-paper)}
  .mface .mf-fretline{stroke:var(--mf-on-paper-soft);stroke-width:1.4}
  .mface .mf-nut{fill:var(--mf-on-paper)}
  .mface .mf-string{stroke:var(--mf-on-paper);stroke-width:1.2}
  .mface .mf-string.mf-wound{stroke-width:2}
  .mface .mf-inlay{fill:var(--mf-on-paper-soft);opacity:.5}
  .mface .mf-open-mark{fill:none;stroke:var(--mf-on-paper);stroke-width:1.5}
  .mface .mf-finger{fill:var(--mf-accent)}
  .mface .mf-peg{fill:var(--mf-accent-ink)}
  .mface .mf-neckgroup{transform-box:view-box;transform-origin:center;transition:transform .6s var(--mf-ease)}
  .mface .mf-fret.mf-left .mf-neckgroup{transform:scaleX(-1)}
  .mface .mf-fbcaption{font-family:var(--mf-mono);font-size:.78rem;color:var(--mf-on-paper-soft);margin-top:.9rem}
  .mface .mf-fbcaption b{color:var(--mf-accent-deep);font-weight:500}
  .mface .mf-fname-side{font-family:var(--mf-mono);font-size:12px;fill:var(--mf-on-paper-soft)}

  /* cta + meta */
  .mface .mf-cta-row{display:flex;flex-wrap:wrap;gap:1rem;margin-top:clamp(1.6rem,3vw,2.2rem)}
  .mface .mf-cta{display:inline-flex;align-items:center;gap:.7rem;
    font-family:var(--mf-mono);font-size:.84rem;font-weight:500;letter-spacing:.01em;
    text-decoration:none;padding:.95rem 1.35rem;border:1.5px solid var(--mf-ink);
    background:transparent;color:var(--mf-ink);border-radius:3px;
    transition:transform .35s var(--mf-ease),background .35s var(--mf-ease),color .35s var(--mf-ease)}
  .mface .mf-cta .mf-gl{color:var(--mf-accent-ink);font-weight:700}
  .mface .mf-cta:hover{transform:translateY(-3px);background:var(--mf-ink);color:var(--mf-on-ink)}
  .mface .mf-cta:hover .mf-gl{color:var(--mf-accent)}

  .mface .mf-meta{display:flex;flex-direction:column;gap:.5rem}
  .mface .mf-note{font-family:var(--mf-mono);font-size:.8rem;letter-spacing:.03em;color:var(--mf-on-paper-soft);margin:0}
  .mface .mf-note .mf-amp{color:var(--mf-accent-ink)}

  @media(min-width:900px){
    .mface .mf-grid{grid-template-columns:minmax(220px,.42fr) minmax(0,1fr)}
    .mface .mf-meta{order:-1}
  }
  @media(prefers-reduced-motion:reduce){
    .mface .mf-neckgroup{transition:none}
    .mface .mf-cta{transition:none}
  }
  </style>

  <div class="mf-grid">
    <div>
      <h2 class="mf-title">The musician<span class="mf-amp">.</span></h2>
      <p class="mf-lede">
        Right-handed, until <span class="mf-hl">focal dystonia</span> closed that hand on the strings.
        So I turned the banjo over and started again, left-handed — new hand, same tunes,
        slower and truer. The relearning isn't a footnote. It <span class="mf-hl">is</span> the music now.
      </p>

      <div class="mf-score">
        <!-- TABLATURE (standard orientation — never mirrored) -->
        <div class="mf-panel">
          <div class="mf-bar">
            <span class="mf-pl">tablature</span>
            <span class="mf-pt">forward roll · open G</span>
          </div>
          <svg class="mf-tab" viewBox="0 0 680 184" role="img"
            aria-label="Five-string banjo tablature: a forward roll in open G over two measures. Strings from top to bottom are D, B, G, D and the short fifth string g. The fifth string sounds open throughout; the second measure adds a hammer-on from open to the second fret on the G string.">
            <g aria-hidden="true">
              <!-- clef T A B -->
              <text class="mf-clef" x="16" y="42">T</text>
              <text class="mf-clef" x="16" y="78">A</text>
              <text class="mf-clef" x="16" y="114">B</text>
              <!-- string lines -->
              <line class="mf-staff" x1="56" y1="30" x2="664" y2="30"/>
              <line class="mf-staff" x1="56" y1="58" x2="664" y2="58"/>
              <line class="mf-staff" x1="56" y1="86" x2="664" y2="86"/>
              <line class="mf-staff" x1="56" y1="114" x2="664" y2="114"/>
              <line class="mf-staff" x1="56" y1="142" x2="664" y2="142"/>
              <!-- string names -->
              <text class="mf-sname" x="40" y="34" text-anchor="end">D</text>
              <text class="mf-sname" x="40" y="62" text-anchor="end">B</text>
              <text class="mf-sname" x="40" y="90" text-anchor="end">G</text>
              <text class="mf-sname" x="40" y="118" text-anchor="end">D</text>
              <text class="mf-sname" x="40" y="146" text-anchor="end">g</text>
              <!-- barlines -->
              <line class="mf-barline" x1="56" y1="30" x2="56" y2="142"/>
              <line class="mf-barline" x1="360" y1="30" x2="360" y2="142"/>
              <line class="mf-barline" x1="662" y1="30" x2="662" y2="142"/>
              <line class="mf-barline" x1="657" y1="30" x2="657" y2="142"/>
              <!-- NUMBERS: measure 1 (open-G forward roll) -->
              <rect class="mf-slab" x="83" y="78" width="14" height="16"/><text class="mf-num" x="90" y="91" text-anchor="middle">0</text>
              <rect class="mf-slab" x="119" y="50" width="14" height="16"/><text class="mf-num" x="126" y="63" text-anchor="middle">0</text>
              <rect class="mf-slab" x="155" y="22" width="14" height="16"/><text class="mf-num" x="162" y="35" text-anchor="middle">0</text>
              <rect class="mf-slab" x="191" y="134" width="14" height="16"/><text class="mf-num" x="198" y="147" text-anchor="middle">0</text>
              <rect class="mf-slab" x="227" y="78" width="14" height="16"/><text class="mf-num" x="234" y="91" text-anchor="middle">0</text>
              <rect class="mf-slab" x="263" y="50" width="14" height="16"/><text class="mf-num" x="270" y="63" text-anchor="middle">0</text>
              <rect class="mf-slab" x="299" y="22" width="14" height="16"/><text class="mf-num" x="306" y="35" text-anchor="middle">0</text>
              <rect class="mf-slab" x="335" y="134" width="14" height="16"/><text class="mf-num" x="342" y="147" text-anchor="middle">0</text>
              <!-- measure 2 -->
              <rect class="mf-slab" x="367" y="78" width="30" height="16"/><text class="mf-num" x="382" y="91" text-anchor="middle">0h2</text>
              <rect class="mf-slab" x="407" y="50" width="14" height="16"/><text class="mf-num" x="414" y="63" text-anchor="middle">0</text>
              <rect class="mf-slab" x="443" y="22" width="14" height="16"/><text class="mf-num" x="450" y="35" text-anchor="middle">0</text>
              <rect class="mf-slab" x="479" y="134" width="14" height="16"/><text class="mf-num" x="486" y="147" text-anchor="middle">0</text>
              <rect class="mf-slab" x="515" y="106" width="14" height="16"/><text class="mf-num" x="522" y="119" text-anchor="middle">2</text>
              <rect class="mf-slab" x="551" y="50" width="14" height="16"/><text class="mf-num" x="558" y="63" text-anchor="middle">0</text>
              <rect class="mf-slab" x="587" y="22" width="14" height="16"/><text class="mf-num" x="594" y="35" text-anchor="middle">0</text>
              <rect class="mf-slab" x="623" y="134" width="14" height="16"/><text class="mf-num" x="630" y="147" text-anchor="middle">0</text>
              <!-- picking marks under staff -->
              <text class="mf-sname" x="90"  y="172" text-anchor="middle">T</text>
              <text class="mf-sname" x="126" y="172" text-anchor="middle">I</text>
              <text class="mf-sname" x="162" y="172" text-anchor="middle">M</text>
              <text class="mf-sname" x="198" y="172" text-anchor="middle">T</text>
              <text class="mf-sname" x="234" y="172" text-anchor="middle">T</text>
              <text class="mf-sname" x="270" y="172" text-anchor="middle">I</text>
              <text class="mf-sname" x="306" y="172" text-anchor="middle">M</text>
              <text class="mf-sname" x="342" y="172" text-anchor="middle">T</text>
            </g>
          </svg>
        </div>

        <!-- FRETBOARD (defaults to LEFT / mirrored) -->
        <div class="mf-panel">
          <div class="mf-fbhead">
            <span class="mf-bar" style="margin:0"><span class="mf-pl">fretboard</span></span>
            <div class="mf-seg" role="group" aria-label="Playing hand">
              <button type="button" class="mf-hand-right" aria-pressed="false">Right</button>
              <button type="button" class="mf-hand-left" aria-pressed="true">Left</button>
            </div>
          </div>
          <svg class="mf-fret mf-left mf-fretboard" viewBox="0 0 680 230" role="img"
            aria-label="A five-string banjo neck diagram. Four long strings run the length of the neck; the short fifth string begins at the fifth fret. One finger is placed at the second fret of the G string; the other strings ring open. The diagram can be mirrored between a right-handed and a left-handed orientation.">
            <g class="mf-neckgroup">
              <!-- neck -->
              <rect class="mf-neck" x="80" y="40" width="552" height="150" rx="4"/>
              <!-- nut -->
              <rect class="mf-nut" x="76" y="38" width="8" height="154" rx="2"/>
              <!-- fretwires (7 frets) -->
              <line class="mf-fretline" x1="159" y1="40" x2="159" y2="190"/>
              <line class="mf-fretline" x1="238" y1="40" x2="238" y2="190"/>
              <line class="mf-fretline" x1="317" y1="40" x2="317" y2="190"/>
              <line class="mf-fretline" x1="396" y1="40" x2="396" y2="190"/>
              <line class="mf-fretline" x1="475" y1="40" x2="475" y2="190"/>
              <line class="mf-fretline" x1="554" y1="40" x2="554" y2="190"/>
              <line class="mf-fretline" x1="632" y1="40" x2="632" y2="190"/>
              <!-- inlays (frets 3 and 7 spaces) -->
              <circle class="mf-inlay" cx="277" cy="115" r="6"/>
              <circle class="mf-inlay" cx="593" cy="115" r="6"/>
              <!-- strings 1-4 full length -->
              <line class="mf-string" x1="84" y1="58"  x2="632" y2="58"/>
              <line class="mf-string" x1="84" y1="92"  x2="632" y2="92"/>
              <line class="mf-string" x1="84" y1="126" x2="632" y2="126"/>
              <line class="mf-string mf-wound" x1="84" y1="160" x2="632" y2="160"/>
              <!-- 5th string: begins at 5th fret (x=475) -->
              <line class="mf-string" x1="475" y1="178" x2="632" y2="178"/>
              <circle class="mf-peg" cx="475" cy="178" r="5"/>
              <!-- open markers at nut -->
              <circle class="mf-open-mark" cx="68" cy="58"  r="5"/>
              <circle class="mf-open-mark" cx="68" cy="92"  r="5"/>
              <circle class="mf-open-mark" cx="68" cy="160" r="5"/>
              <!-- finger: G string (y=126) at 2nd fret (between 159 & 238 -> 198) -->
              <circle class="mf-finger" cx="198" cy="126" r="11"/>
            </g>
            <!-- static labels (unflipped, positioned by y only) -->
            <g aria-hidden="true">
              <text class="mf-fname-side" x="40" y="62"  text-anchor="middle">D</text>
              <text class="mf-fname-side" x="40" y="96"  text-anchor="middle">B</text>
              <text class="mf-fname-side" x="40" y="130" text-anchor="middle">G</text>
              <text class="mf-fname-side" x="40" y="164" text-anchor="middle">D</text>
              <text class="mf-fname-side" x="40" y="206" text-anchor="middle">g</text>
            </g>
          </svg>
          <p class="mf-fbcaption"><b>Left-handed</b> — how I play now. Flip it to see where I started.</p>
        </div>
      </div>

      <div class="mf-cta-row">
        <a class="mf-cta" href="mailto:alexey@chudinov.example?subject=The%20journey"><span class="mf-gl" aria-hidden="true">0&nbsp;2&nbsp;0</span> Hear the journey</a>
      </div>
    </div>

    <aside class="mf-meta" aria-label="Musician details">
      <p class="mf-note"><span class="mf-amp">//</span> soul.02 — tablature</p>
      <p class="mf-note">instrument = 5-string banjo</p>
      <p class="mf-note">style&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;= bluegrass</p>
      <p class="mf-note">hand&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;= right → left</p>
      <p class="mf-note">status&nbsp;&nbsp;&nbsp;&nbsp;= relearning, daily</p>
    </aside>
  </div>

  <script is:inline>
  (function(){
    var root = document.querySelector('.mface');
    if (!root || root.dataset.mfInit) return;
    root.dataset.mfInit = '1';

    var fb  = root.querySelector('.mf-fretboard');
    var bR  = root.querySelector('.mf-hand-right');
    var bL  = root.querySelector('.mf-hand-left');
    var cap = root.querySelector('.mf-fbcaption');
    if (!fb || !bR || !bL || !cap) return;

    function setHand(left){
      fb.classList.toggle('mf-left', left);
      bL.setAttribute('aria-pressed', String(left));
      bR.setAttribute('aria-pressed', String(!left));
      cap.innerHTML = left
        ? '<b>Left-handed</b> — how I play now. Flip it to see where I started.'
        : '<b>Right-handed</b> — where I started, before focal dystonia. Flip it back to now.';
    }
    bR.addEventListener('click', function(){ setHand(false); });
    bL.addEventListener('click', function(){ setHand(true); });
  })();
  </script>
</section>
</div>
<!-- end music face -->
