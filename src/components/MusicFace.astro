  <script is:inline define:vars={{ mf }}>
  (function(){
    var root = document.querySelector('.mface');
    if (!root || root.dataset.mfInit) return;
    root.dataset.mfInit = '1';

    // ---- fact panels: pluck a string to swap the shown panel ----
    var panels = [].slice.call(root.querySelectorAll('.mf-fp'));
    var current = 'default';
    function show(k){
      panels.forEach(function(p){
        var on = p.getAttribute('data-k') === k;
        p.hidden = !on;
        p.classList.toggle('is-on', on);
      });
    }

    // ---- the banjo instrument = menu; each string plucks (bows) and selects its fact ----
    // Assembly ported verbatim from the tuned source (banjo-strings.html); slider
    // controls dropped and the five FINAL BAKED PARAMS hard-coded below for easy retune.
    var NS = 'http://www.w3.org/2000/svg';
    var svg = root.querySelector('.mf-instr-svg');
    var gStrings = root.querySelector('.mf-g-strings');
    var gBridge = root.querySelector('.mf-g-bridge');
    var gTail = root.querySelector('.mf-g-tail');
    var assembly = root.querySelector('.mf-assembly');
    var stage = root.querySelector('.mf-stage');
    var mqMobile = (function(){ try { return matchMedia('(max-width:759px)'); } catch(e){ return { matches:false }; } })();
    var REDUCE = (function(){ try { return matchMedia('(prefers-reduced-motion: reduce)').matches; } catch(e){ return false; } })();

    // FINAL BAKED PARAMS (tuned on banjo-strings.html — no sliders on the site) ----
    var CX = 200, TAILY = 558;
    var INCLINE = 0;             // no incline
    var BRIDGEY = 680 * 0.60;    // bridge pos 60%
    var BSPREAD = 37;            // bridge spread
    var TSPREAD = 17;            // tail spread
    var TOP = 70;                // playing length
    var GAUGE = [1.3, 2.0, 2.8, 4.0, 1.3]; // 1st & 5th thinnest, 4th wound-thick
    var TITLES = mf.factTitles;  // fact names (localized, passed from the frontmatter)
    var strGroups = [];

    function el(name, attrs){ var e = document.createElementNS(NS, name); for (var a in attrs){ e.setAttribute(a, attrs[a]); } return e; }
    function clearG(g){ while (g.firstChild) g.removeChild(g.firstChild); }

    // pluck: bow the playing segment (neck -> bridge) with a damped oscillation; endpoints stay fixed
    function pluck(path, x, y0, y1){
      var mid = (y0 + y1) / 2, straight = 'M ' + x + ' ' + y0 + ' Q ' + x + ' ' + mid + ' ' + x + ' ' + y1;
      if (REDUCE){ path.setAttribute('d', straight); return; }
      var A = 9, cycles = 26, decay = 5, dur = 560, t0 = performance.now();
      function frame(now){
        var e = (now - t0) / dur;
        if (e >= 1){ path.setAttribute('d', straight); return; }
        var disp = A * Math.sin(e * cycles) * Math.exp(-e * decay);
        path.setAttribute('d', 'M ' + x + ' ' + y0 + ' Q ' + (x + disp) + ' ' + mid + ' ' + x + ' ' + y1);
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }

    function selectFact(k, btn){
      // plucking the already-active string again exits back to the default intro
      var toDefault = (current === k);
      current = toDefault ? 'default' : k;
      show(current);
      strGroups.forEach(function(g){ g.setAttribute('aria-pressed', (!toDefault && g === btn) ? 'true' : 'false'); });
      // mobile: the content panel sits below the hero — scroll down to it (not when exiting)
      if (!toDefault && mqMobile.matches && stage){
        try { stage.scrollIntoView({ behavior: REDUCE ? 'auto' : 'smooth', block: 'start' }); }
        catch(e){ stage.scrollIntoView(); }
      }
    }

    function applyIncline(){ assembly.setAttribute('transform', 'rotate(' + INCLINE + ' ' + CX + ' ' + ((TOP + TAILY) / 2) + ')'); }

    function draw(){
      // ---- strings ----
      clearG(gStrings);
      strGroups = [];
      for (var i = 0; i < 5; i++){
        var xt = CX + (i - 2) * BSPREAD;
        var xa = CX + (i - 2) * TSPREAD;
        var mid = (TOP + BRIDGEY) / 2;
        var g = el('g', { 'class':'mf-istring', 'tabindex':'0', 'role':'button', 'aria-pressed':'false',
          'aria-label': mf.pluckAria.replace('{n}', i + 1).replace('{title}', TITLES[i]) });
        // wider invisible hit area over the whole string (centre extends past the tuck)
        var hitPts = xt + ',' + TOP + ' ' + xt + ',' + BRIDGEY + ' ' + xa + ',' + TAILY;
        if (i === 2) hitPts += ' ' + xa + ',' + (TAILY + 16);
        var hit = el('polyline', { points: hitPts, fill:'none', stroke:'transparent', 'stroke-width':16 });
        // dead segment behind the bridge (bridge -> tailpiece); the centre string runs on
        // down and UNDER the plate, so the tailpiece hides its end (z-order)
        var tailEndY = (i === 2) ? (TAILY + 40) : TAILY;
        var tail = el('polyline', { 'class':'mf-iwire', points: xt + ',' + BRIDGEY + ' ' + xa + ',' + tailEndY,
          fill:'none', stroke:'#5b5446', 'stroke-width':GAUGE[i], 'stroke-linecap':'round' });
        // playing length (neck -> bridge): the part that vibrates when plucked
        var top = el('path', { 'class':'mf-iwire', d:'M ' + xt + ' ' + TOP + ' Q ' + xt + ' ' + mid + ' ' + xt + ' ' + BRIDGEY,
          fill:'none', stroke:'#5b5446', 'stroke-width':GAUGE[i], 'stroke-linecap':'round' });
        g.appendChild(hit); g.appendChild(tail); g.appendChild(top);
        (function(path, x, y0, y1, k, btn){
          function fire(){ pluck(path, x, y0, y1); selectFact(k, btn); }
          btn.addEventListener('click', fire);
          btn.addEventListener('keydown', function(e){ if (e.key === 'Enter' || e.key === ' '){ e.preventDefault(); fire(); } });
        })(top, xt, TOP, BRIDGEY, String(i), g);
        strGroups.push(g);
        gStrings.appendChild(g);
      }
      // ---- bridge: v3, injected verbatim and scaled so its 104.3u notch spacing maps
      //      to the string SPREAD (bridge size fixed at the spread-30 look) ----
      var bs = 30 / 104.3;
      gBridge.setAttribute('transform', 'translate(' + CX + ' ' + BRIDGEY + ') scale(' + bs + ') translate(-430 -37.6)');
      gBridge.innerHTML =
        '<defs>'
        + '<linearGradient id="mf-maple3" x1="0" y1="77" x2="0" y2="200" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#ecdcb4"/><stop offset="0.55" stop-color="#e3cfa0"/><stop offset="1" stop-color="#d2b982"/></linearGradient>'
        + '<linearGradient id="mf-ebony3" x1="0" y1="37.6" x2="0" y2="77.6" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#352a1e"/><stop offset="0.25" stop-color="#241c15"/><stop offset="1" stop-color="#1c150f"/></linearGradient>'
        + '<filter id="mf-soft3" x="-20%" y="-150%" width="140%" height="400%"><feGaussianBlur stdDeviation="3.2"/></filter>'
        + '</defs>'
        + '<g filter="url(#mf-soft3)" fill="#6b5a3c" opacity="0.22"><rect x="54" y="199.5" width="212" height="5.5" rx="2.5"/><rect x="337" y="199.5" width="186" height="5.5" rx="2.5"/><rect x="594" y="199.5" width="212" height="5.5" rx="2.5"/></g>'
        + '<path fill="#e4d1a0" stroke="#b79a63" stroke-width="1.6" stroke-linejoin="round" d="M 117,77.6 C 121,86 123.5,94 123.5,102 C 123.5,113 121,121 121,132 C 119,146 112,157 101,166 C 90,175 76,183 62,188 L 55,190 Q 50.5,191.5 50.5,196 L 50.5,200 L 269,200 L 269,183 Q 269,179 265,179 L 234,179 A 30 30 0 0 1 204,149 L 204,134 A 25 25 0 0 1 229,109 L 374,109 A 25 25 0 0 1 399,134 L 399,149 A 30 30 0 0 1 369,179 L 338,179 Q 334,179 334,183 L 334,200 L 526,200 L 526,183 Q 526,179 522,179 L 491,179 A 30 30 0 0 1 461,149 L 461,134 A 25 25 0 0 1 486,109 L 631,109 A 25 25 0 0 1 656,134 L 656,149 A 30 30 0 0 1 626,179 L 595,179 Q 591,179 591,183 L 591,200 L 809.5,200 L 809.5,196 Q 809.5,191.5 805,190 L 798,188 C 784,183 770,175 759,166 C 748,157 741,146 739,132 C 739,121 736.5,113 736.5,102 C 736.5,94 739,86 743,77.6 Z"/>'
        + '<path fill="url(#mf-ebony3)" stroke="#120d09" stroke-width="1" stroke-linejoin="round" d="M 117,77.6 L 117,42 Q 117,37.6 122,37.6 L 738,37.6 Q 743,37.6 743,42 L 743,77.6 Z"/>';

      // ---- tailpiece: Deering-style flat-gray plate — two T-ears with a centre notch,
      //      a keyhole slot, slight taper, strings running down the face to anchor ----
      clearG(gTail);
      var topHalf = 46, botHalf = 41;
      var left = CX - topHalf, right = CX + topHalf, bL = CX - botHalf, bR = CX + botHalf;
      var pTop = TAILY, pBot = TAILY + 120, rr = 7;
      var pc = 28, stemW = 26, capW = 38, capH = 15, stemTop = pTop - 24;
      // two T-ears (drawn first so the plate top merges their stems)
      [CX - pc, CX + pc].forEach(function(cx){
        gTail.appendChild(el('rect', { x:cx - stemW/2, y:stemTop + capH - 2, width:stemW, height:pTop - (stemTop + capH) + 8, fill:'#c7c6c1' }));
        gTail.appendChild(el('rect', { x:cx - capW/2, y:stemTop, width:capW, height:capH, rx:5, fill:'#c7c6c1', stroke:'#8f8d86', 'stroke-width':1 }));
        gTail.appendChild(el('rect', { x:cx - capW/2 + 3, y:stemTop + 2, width:capW - 6, height:2, rx:1, fill:'rgba(255,255,255,.2)' }));
      });
      // main plate: top edge with a shallow centre notch, tapering body, rounded corners
      var nH = 12;
      var d = 'M ' + left + ' ' + (pTop + rr)
        + ' Q ' + left + ' ' + pTop + ' ' + (left + rr) + ' ' + pTop
        + ' L ' + (CX - 12) + ' ' + pTop + ' L ' + (CX - 12) + ' ' + (pTop + nH) + ' L ' + (CX + 12) + ' ' + (pTop + nH) + ' L ' + (CX + 12) + ' ' + pTop
        + ' L ' + (right - rr) + ' ' + pTop + ' Q ' + right + ' ' + pTop + ' ' + right + ' ' + (pTop + rr)
        + ' L ' + bR + ' ' + (pBot - rr) + ' Q ' + bR + ' ' + pBot + ' ' + (bR - rr) + ' ' + pBot
        + ' L ' + (bL + rr) + ' ' + pBot + ' Q ' + bL + ' ' + pBot + ' ' + bL + ' ' + (pBot - rr)
        + ' L ' + left + ' ' + (pTop + rr) + ' Z';
      gTail.appendChild(el('path', { d:d, fill:'#c7c6c1', stroke:'#8f8d86', 'stroke-width':1.3 }));
      // inner bevel sheen down the left
      gTail.appendChild(el('path', { d:'M ' + (left + 5) + ' ' + (pTop + rr + 3) + ' L ' + (bL + 5) + ' ' + (pBot - rr - 3), fill:'none', stroke:'rgba(255,255,255,.12)', 'stroke-width':1 }));
      // keyhole slot (upper middle) — shows the head through it
      gTail.appendChild(el('rect', { x:CX - 5, y:pTop + 24, width:10, height:30, rx:5, fill:'#e4d8bf', stroke:'rgba(20,18,16,.32)', 'stroke-width':1 }));
      // strings running down the face, anchoring at the base
      for (var t = 0; t < 5; t++){
        var xTop = CX + (t - 2) * TSPREAD, xBot = CX + (t - 2) * (TSPREAD * 0.9);
        var gg = GAUGE[t] || 1.5;
        // on-tailpiece piece; the centre one starts below the tuck (its top is hidden under the plate)
        var faceTop = (t === 2) ? pTop + 29 : pTop + 7;
        gTail.appendChild(el('line', { x1:xTop, y1:faceTop, x2:xBot, y2:pBot - 4, stroke:'#5b5446', 'stroke-width':gg, 'stroke-linecap':'round', opacity:0.92 }));
      }
      // top-edge highlight
      gTail.appendChild(el('path', { d:'M ' + (left + 7) + ' ' + (pTop + 3) + ' L ' + (CX - 14) + ' ' + (pTop + 3), stroke:'rgba(255,255,255,.4)', 'stroke-width':1.4, fill:'none', 'stroke-linecap':'round' }));

      applyIncline();
    }

    if (svg && gStrings && gBridge && gTail && assembly){
      gTail.setAttribute('pointer-events', 'none'); // let string clicks pass through the tailpiece
      draw();
    }

    // ---- YouTube in a modal lightbox: iframe loads on open, destroyed on close ----
    (function(){
      var triggers = [].slice.call(root.querySelectorAll('.mf-yt'));
      if (!triggers.length) return;
      var modal, frameHost, lastFocus;
      function build(){
        modal = document.createElement('div');
        modal.className = 'mf-modal';
        modal.setAttribute('hidden', '');
        modal.innerHTML =
          '<div class="mf-modal-backdrop" data-close></div>' +
          '<div class="mf-modal-dialog" role="dialog" aria-modal="true" aria-label="Video player">' +
            '<button type="button" class="mf-modal-close" data-close aria-label="Close video">' +
              '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 5 L19 19 M19 5 L5 19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>' +
            '</button>' +
            '<div class="mf-modal-frame"></div>' +
          '</div>';
        document.body.appendChild(modal);
        frameHost = modal.querySelector('.mf-modal-frame');
        modal.addEventListener('click', function(e){ if (e.target.closest('[data-close]')) close(); });
        document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && !modal.hasAttribute('hidden')) close(); });
      }
      function open(id, label){
        if (!modal) build();
        lastFocus = document.activeElement;
        var f = document.createElement('iframe');
        f.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
        f.title = label || 'YouTube video';
        f.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture; fullscreen');
        f.setAttribute('allowfullscreen', '');
        frameHost.appendChild(f);
        modal.removeAttribute('hidden');
        document.documentElement.style.overflow = 'hidden';
        try { modal.querySelector('.mf-modal-close').focus(); } catch (e){}
      }
      function close(){
        if (!modal || modal.hasAttribute('hidden')) return;
        modal.setAttribute('hidden', '');
        frameHost.innerHTML = '';                 // remove iframe → stops playback
        document.documentElement.style.overflow = '';
        try { if (lastFocus) lastFocus.focus(); } catch (e){}
      }
      triggers.forEach(function(b){
        b.addEventListener('click', function(){ open(b.getAttribute('data-yt'), b.getAttribute('aria-label')); });
      });
    })();

    // ---- "da capo": scroll back to the top (mobile) ----
    var dacapo = root.querySelector('.mf-dacapo');
    if (dacapo){
      dacapo.addEventListener('click', function(){
        try { window.scrollTo({ top: 0, left: 0, behavior: REDUCE ? 'auto' : 'smooth' }); }
        catch (e){ window.scrollTo(0, 0); }
      });
    }

    // ---- fretboard right/left toggle (inside the "the neck" fact) ----
    var fb = root.querySelector('.mf-fretboard');
    var bR = root.querySelector('.mf-hand-right');
    var bL = root.querySelector('.mf-hand-left');
    var cap = root.querySelector('.mf-fbcaption');
    if (!fb || !bR || !bL || !cap) return;
    function setHand(left){
      fb.classList.toggle('mf-left', left);
      bL.setAttribute('aria-pressed', String(left));
      bR.setAttribute('aria-pressed', String(!left));
      cap.innerHTML = left ? mf.captionLeft : mf.captionRight;
    }
    bR.addEventListener('click', function(){ setHand(false); });
    bL.addEventListener('click', function(){ setHand(true); });
  })();
  </script>
</section>
  <footer class="mfoot">
    <div class="mfoot-wrap">
      <span>{t('footer.site')}</span>
      <span>{t('footer.music')}</span>
    </div>
  </footer>
</div>
<!-- end music face -->
